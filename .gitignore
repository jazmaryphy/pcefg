# Byte-compiled /cache / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.DS_Store

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# notebook
# Ignore notebooks globally
*.ipynb

# Allow Git to traverse into examples/ and ALL of its subdirectories
!examples/
!examples/**/

# Un-ignore .ipynb files directly in examples/ AND inside any subfolder
!examples/*.ipynb
!examples/**/*.ipynb

# Same rule for notebooks/ folder (if applicable)
!notebooks/
!notebooks/**/
!notebooks/*.ipynb
!notebooks/**/*.ipynb

#!tests/**/*.ipynb  # allows .ipynb in tests/ folder
#!tests/*.ipynb     # allows .ipynb inside any subdirectories of tests/

# Logs
*.log

# Environments
.venv/
venv/
env/

# Testing & IDEs
.pytest_cache/
.coverage
htmlcov/
.idea/
.vscode/


# Large data folder you want to ignore
#tests/test_al2o3.py
